# Copy to .env and edit. `docker compose up` works on a clean clone using these values as defaults; .env overrides them.
# Nothing secret belongs in this file. Put real keys only in your own, git-ignored .env.

# ---- service wiring (inside the compose network) ----
REDIS_URL=redis://redis:6379/0
INDEX_DIR=/data/index
CORPUS_DIR=corpus
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# ---- model provider ----
# Default: the stub service (deterministic, offline, used for load tests). To use a real model, point these at any
# OpenAI-compatible endpoint (a provider's free tier, or a local server) and set your key in .env.
LLM_PROVIDER=openai_compat
LLM_BASE_URL=http://stub-llm:8081/v1
LLM_MODEL=stub
LLM_API_KEY=
# What happens when the provider is down: rules = offline rule engine (flagged "degraded"); none = escalate to a human
LLM_FALLBACK=rules
STUB_DELAY_MS=800

# ---- embeddings ----  sentence-transformers runs locally (no API, no cost). The model is downloaded once into the
# index-data volume (HF_HOME=/data/hf) by the indexer on first start. EMBEDDER=hash is the offline lexical fallback
# (no download; also used by the tests); an image built with INSTALL_ST=0 supports only that.
EMBEDDER=sentence-transformers
EMBED_MODEL=all-MiniLM-L6-v2
EMBED_DIM=512
CHUNKING=clause
CHUNK_HEADERS=1

# ---- agent limits (A1) and reliability (A5) ----
MAX_STEPS=10
MAX_TOOL_CALLS=10
RUN_TIMEOUT_S=90
MAX_VERIFY_ATTEMPTS=2
LLM_TIMEOUT_S=30
LLM_MAX_TOKENS=2000
# For thinking models (e.g. gemma4 on Ollama) set none so the output budget is spent on the answer. Empty = not sent.
LLM_REASONING_EFFORT=
LLM_MAX_RETRIES=2
LLM_BACKOFF_BASE_S=0.5
BREAKER_FAILURES=3
BREAKER_COOLDOWN_S=20
TOOL_TIMEOUT_S=10
STALE_RUN_S=120

# ---- prompts (L2) ----
PROMPT_VERSION=v2

# ---- cost accounting (L5): notional price per 1000 tokens, set to your provider's prices (0 on a free tier) ----
PRICE_PROMPT_PER_1K=0.0005
PRICE_COMPLETION_PER_1K=0.0015

# ---- caching, rate limiting, workers (D7, A7) ----
CACHE_TTL_S=3600
RATE_LIMIT_PER_MIN=30
WORKER_CONCURRENCY=4
QUALITY_SAMPLE_RATE=0.2

# ---- load test target (Locust reads LOCUST_HOST) ----
LOCUST_HOST=http://api:8000

# ---- SLO (D6): declared in docs/slo.md BEFORE measuring ----
SLO_P95_SECONDS=30

# ---- demo only: lets the X-Debug-Fault header corrupt a first answer to demonstrate verification (demo item 6). Keep 0 in production.
ENABLE_FAULT_INJECTION=1
LOG_LEVEL=INFO
